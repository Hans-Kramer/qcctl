#
# Fan curves for the Arduino Ventuno Q.
#
# These only take effect for a profile that says FAN MODE curve. Under the default
# FAN MODE kernel the board's own thermal governor keeps the fan.
#
# Units are mandatory, as in profiles.conf. Points must ascend in temperature and
# must not step down as it gets hotter.
#
# The fan has 11 states, 0-10, where pwm = round(state * 255 / 10).
# MIN_STATE 2 is strongly advised: at state 1 the tachometer misreads, so fan speed cannot be trusted there.
# State 0 (off) stays available regardless.

# ==========
# FAN CURVES
# ==========
< CURVE NAME=desktop >
  ZONE cpuss-0-0
  POINT 30C STATE 0       # off below 30C
  POINT 38C STATE 4       # 40%, where the stock config jumps to
  POINT 50C STATE 6
  POINT 65C STATE 8
  POINT 75C STATE 10      # 100%
  HYSTERESIS 4C
  MIN_STATE 2
  POLL 2s
  FAILSAFE kernel
>

# Quieter: starts later, tops out lower, and a wide hysteresis so it changes speed rarely.
< CURVE NAME=quiet >
  ZONE cpuss-0-0
  POINT 45C STATE 0
  POINT 55C STATE 3
  POINT 68C STATE 6
  POINT 80C STATE 9
  HYSTERESIS 8C
  MIN_STATE 2
  POLL 5s
  FAILSAFE kernel
>

# For sustained load: on early, climbs fast, and FAILSAFE full so that losing the
# daemon leaves the fan at maximum rather than handing a hot board back to a
# governor whose only active trip is at 38C.
< CURVE NAME=sustained >
  ZONE cpuss-0-0
  POINT 28C STATE 3
  POINT 40C STATE 6
  POINT 52C STATE 8
  POINT 62C STATE 10
  HYSTERESIS 3C
  MIN_STATE 2
  POLL 1s
  FAILSAFE full
>

< CURVE NAME=fallback >
  ZONE cpuss-0-0
  POINT 30C STATE 0       # off below 30C
  POINT 40C STATE 6
  POINT 50C STATE 10
  HYSTERESIS 3C
  MIN_STATE 2
  POLL 1s
  FAILSAFE full
>

# ==================
# TARGET TEMPERATURE
# ==================
# TARGET blocks are a different KIND, not a curve with a flag. A CURVE is a stateless
# lookup; a TARGET is a closed-loop controller that needs history and a clock.
< TARGET NAME=held40 >
  ZONE cpuss-0-0
  TARGET 40C
  DEADBAND 1C
  MIN_STATE 2
  STEP_INTERVAL 15s     # the board's thermal time constant, not the poll rate
  POLL 2s
  FAILSAFE kernel
>

# ==========
# FAN HEALTH
# ==========
# Fan (airflow) health. ONE block per file.
#
# The delta is signed and BOTH directions mean something, assume:
#   above baseline -> restricted intake, blocked airflow
#   below baseline -> the fan is not delivering: bearing wear, dust-loaded impeller, etc.
#
# This needs a reference first, captured on YOUR board, if applicable in YOUR enclosure:
#   sudo qcctl --fan-baseline capture
#
# If You comment this block out and nothing is judged.
< AIRFLOW >
  DELTA    8%
  DEBOUNCE 3
>
